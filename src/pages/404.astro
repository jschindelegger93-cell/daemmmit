---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden | Dämm-Mit" description="Diese Seite gibt es nicht (mehr)." noindex>
  <section class="sec"><div class="wrap" style="text-align:center">
    <p class="eyebrow" style="justify-content:center">Fehler 404</p>
    <h1>Diese Seite ist nicht mehr im Kreislauf.</h1>
    <p class="lead" style="margin-inline:auto">Kein Problem – hier geht es weiter:</p>
    <div class="btns" style="justify-content:center"><a class="btn btn--pri" href="/">Zur Startseite</a><a class="btn btn--out" href="/shop/">Zum Shop</a><button class="btn btn--out" type="button" data-modal>Beratung anfragen</button></div>
  </div></section>
</Base>
